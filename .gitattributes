# Keep text files on LF.
* text=auto eol=lf

# Source and web assets.
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Configuration files.
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Documentation.
*.txt text eol=lf
*.md text eol=lf

# Shell scripts.
*.sh text eol=lf

# Windows scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.tiff binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.node binary
*.so binary
*.dll binary
*.dylib binary
*.safetensors binary

# Generated dependency files.
package-lock.json linguist-generated=true

# Git configuration files are not exported.
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
