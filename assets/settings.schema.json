{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "log_level",
    "locale",
    "game_url",
    "majsoul_server",
    "mitm",
    "model_config"
  ],
  "properties": {
    "log_level": {
      "type": "string",
      "enum": ["error", "warn", "info", "verbose", "debug"],
      "default": "info",
      "description": "Logging detail, using electron-log's level names, least detailed first. `verbose` records the per-item game detail (decoded packets, engine decisions, HUD payloads) and is what to use when reporting a problem; `debug` adds the raw frames."
    },
    "locale": {
      "type": "string",
      "enum": ["zh-CN", "zh-TW", "en-US", "ja-JP"],
      "default": "en-US",
      "description": "UI Language locale."
    },
    "game_url": {
      "type": "string",
      "default": "https://game.maj-soul.com/1/",
      "readOnly": true,
      "description": "Backend-derived game URL for internal Electron window."
    },
    "majsoul_server": {
      "type": "string",
      "enum": ["cn", "jp", "en"],
      "default": "cn",
      "description": "Majsoul server used to derive the game URL."
    },
    "mitm": {
      "type": "object",
      "description": "MITM proxy configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable MITM proxy."
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "MITM proxy listening host."
        },
        "port": {
          "type": "integer",
          "default": 6789,
          "minimum": 1024,
          "maximum": 65535,
          "description": "MITM proxy listening port."
        },
        "upstream": {
          "type": "string",
          "default": "",
          "description": "Upstream proxy URL (e.g. http://127.0.0.1:7890)."
        }
      },
      "required": ["enabled", "host", "port", "upstream"],
      "additionalProperties": false
    },
    "model_config": {
      "type": "object",
      "description": "AI model configuration.",
      "properties": {
        "model_4p": {
          "type": "string",
          "default": "akagi4p.safetensors",
          "description": "Selected model for 4-player mahjong."
        },
        "model_3p": {
          "type": "string",
          "default": "akagi3p.safetensors",
          "description": "Selected model for 3-player mahjong."
        }
      },
      "required": [
        "model_4p",
        "model_3p"
      ],
      "additionalProperties": false
    }
  },
  "description": "Settings for the application.",
  "additionalProperties": false
}
