{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "log_level",
    "locale",
    "game_url",
    "majsoul_server",
    "platform",
    "mitm",
    "server",
    "ot",
    "api",
    "model_config"
  ],
  "properties": {
    "log_level": {
      "type": "string",
      "enum": ["OFF", "TRACE", "DEBUG", "INFO", "WARNING", "ERROR"],
      "default": "INFO",
      "description": "Logging level."
    },
    "locale": {
      "type": "string",
      "enum": ["zh-CN", "zh-TW", "en-US", "ja-JP"],
      "default": "en-US",
      "description": "UI Language locale."
    },
    "game_url": {
      "type": "string",
      "default": "https://game.maj-soul.com/1/",
      "readOnly": true,
      "description": "Backend-derived game URL for internal Electron window."
    },
    "majsoul_server": {
      "type": "string",
      "enum": ["cn", "jp", "en"],
      "default": "cn",
      "description": "Majsoul server used to derive the game URL."
    },
    "platform": {
      "type": "string",
      "enum": ["auto", "majsoul", "tenhou", "amatsuki", "riichi_city"],
      "default": "majsoul",
      "description": "The target mahjong platform."
    },
    "mitm": {
      "type": "object",
      "description": "MITM proxy configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable MITM proxy."
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "MITM proxy listening host."
        },
        "port": {
          "type": "integer",
          "default": 6789,
          "minimum": 1024,
          "maximum": 65535,
          "description": "MITM proxy listening port."
        },
        "upstream": {
          "type": "string",
          "default": "",
          "description": "Upstream proxy URL (e.g. http://127.0.0.1:7890)."
        }
      },
      "required": ["enabled", "host", "port", "upstream"],
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "description": "Data server configuration.",
      "properties": {
        "host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Server listening host."
        },
        "port": {
          "type": "integer",
          "default": 8765,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Server listening port."
        }
      },
      "required": ["host", "port"],
      "additionalProperties": false
    },
    "ot": {
      "description": "Deprecated pre-V3 online tensor-service configuration.",
      "type": "object",
      "properties": {
        "online": {
          "type": "boolean",
          "description": "Whether to use the online service.",
          "default": false
        },
        "server": {
          "type": "string",
          "description": "The server URL for the online service.",
          "default": ""
        },
        "api_key": {
          "type": "string",
          "description": "The API key for the online service.",
          "default": ""
        }
      },
      "required": ["online"],
      "if": {
        "properties": {
          "online": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["server", "api_key"],
        "properties": {
          "server": {
            "minLength": 1,
            "format": "uri"
          },
          "api_key": {
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "api": {
      "description": "Akagi V3 cloud-inference API configuration.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Route decisions through the V3 cloud API."
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "default": "https://mjapi.shinkuan.me",
          "description": "Cloud API base URL."
        },
        "key": {
          "type": "string",
          "default": "",
          "description": "Bearer API key."
        },
        "model_4p": {
          "type": "string",
          "default": "",
          "description": "V3 model id for 4-player games; empty uses the server default."
        },
        "model_3p": {
          "type": "string",
          "default": "",
          "description": "V3 model id for 3-player games; empty uses the server default."
        }
      },
      "required": ["enabled", "base_url", "key", "model_4p", "model_3p"],
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "base_url": {
            "minLength": 1,
            "format": "uri"
          },
          "key": {
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "model_config": {
      "type": "object",
      "description": "AI model configuration.",
      "properties": {
        "model_4p": {
          "type": "string",
          "default": "mortal.pth",
          "description": "Selected model for 4-player mahjong."
        },
        "model_3p": {
          "type": "string",
          "default": "mortal3p.pth",
          "description": "Selected model for 3-player mahjong."
        },
        "temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0.1,
          "maximum": 1.3,
          "description": "Softmax temperature for model confidence normalization."
        }
      },
      "required": [
        "model_4p",
        "model_3p",
        "temperature"
      ],
      "additionalProperties": false
    }
  },
  "description": "Settings for the application.",
  "additionalProperties": false
}
