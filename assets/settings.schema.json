{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "log_level",
    "locale",
    "game_url",
    "majsoul_server",
    "mitm",
    "model_config",
    "ot"
  ],
  "properties": {
    "log_level": {
      "type": "string",
      "enum": ["error", "warn", "info", "verbose", "debug"],
      "default": "info"
    },
    "locale": {
      "type": "string",
      "enum": ["zh-CN", "zh-TW", "en-US", "ja-JP"],
      "default": "en-US",
      "description": "UI Language locale."
    },
    "game_url": {
      "type": "string",
      "default": "https://game.maj-soul.com/1/",
      "readOnly": true,
      "description": "Game URL derived from the selected Majsoul server."
    },
    "majsoul_server": {
      "type": "string",
      "enum": ["cn", "jp", "en"],
      "default": "cn",
      "description": "Majsoul server used to derive the game URL."
    },
    "mitm": {
      "type": "object",
      "description": "MITM proxy configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable MITM proxy."
        },
        "port": {
          "type": "integer",
          "default": 6789,
          "minimum": 1024,
          "maximum": 65535,
          "description": "MITM proxy listening port."
        },
        "upstream": {
          "type": "string",
          "default": "",
          "description": "Upstream proxy URL (e.g. http://127.0.0.1:7890)."
        }
      },
      "required": ["enabled", "port", "upstream"],
      "additionalProperties": false
    },
    "model_config": {
      "type": "object",
      "description": "AI model configuration.",
      "properties": {
        "model_4p": {
          "type": "string",
          "default": "akagi4p.safetensors",
          "description": "Selected model for 4-player mahjong."
        },
        "model_3p": {
          "type": "string",
          "default": "akagi3p.safetensors",
          "description": "Selected model for 3-player mahjong."
        }
      },
      "required": [
        "model_4p",
        "model_3p"
      ],
      "additionalProperties": false
    },
    "ot": {
      "type": "object",
      "description": "Online (OT) model settings. The API key is stored encrypted in config/secrets.json, never here.",
      "properties": {
        "online": {
          "type": "boolean",
          "default": false,
          "description": "Ask the online model for each decision, falling back to the local model."
        },
        "server": {
          "type": "string",
          "default": "https://mjapi.shinkuan.me",
          "readOnly": true,
          "description": "Online model endpoint. Fixed to the official server."
        },
        "model_4p": {
          "type": "string",
          "default": "",
          "description": "Online model id for 4-player games. Empty uses the server default."
        },
        "model_3p": {
          "type": "string",
          "default": "",
          "description": "Online model id for 3-player games. Empty uses the server default."
        },
        "react_timeout_ms": {
          "type": "integer",
          "default": 3000,
          "minimum": 500,
          "maximum": 3000,
          "description": "Per-decision budget for the online model. Above this the local model answers."
        }
      },
      "required": ["online", "server", "model_4p", "model_3p", "react_timeout_ms"],
      "additionalProperties": false
    }
  },
  "description": "Settings for the application.",
  "additionalProperties": false
}
