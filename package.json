{
  "name": "akagi-ng",
  "private": true,
  "version": "1.1.0",
  "description": "Akagi-NG is a next-generation rewrite inspired by Akagi and MajsoulHelper, focusing on modern architecture and UI.",
  "author": "Akagi-NG Contributors",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xe-Persistent/Akagi-NG.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @akagi-ng/frontend\" \"npm run dev -w @akagi-ng/main\"",
    "dev:mock": "concurrently -k \"npm run dev -w @akagi-ng/frontend\" \"npm run dev:mock -w @akagi-ng/main\"",
    "clean": "tsx scripts/clean.ts",
    "sync-version": "tsx scripts/sync_version.ts",
    "prepare-release": "tsx scripts/prepare_release.ts",
    "build": "npm run clean && npm run sync-version && npm run build -w @akagi-ng/frontend && npm run build -w @akagi-ng/main && npm run prepare-release && npm run package -w @akagi-ng/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "npm exec --workspaces -- tsc --noEmit --pretty"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.26.5",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
