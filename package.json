{
  "name": "akagi-ng",
  "private": true,
  "version": "1.2.3",
  "description": "Akagi-NG is a next-generation rewrite inspired by Akagi and MajsoulHelper, focusing on modern architecture and UI.",
  "author": "Akagi-NG Contributors",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xe-Persistent/Akagi-NG.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @akagi-ng/frontend\" \"npm run dev -w @akagi-ng/main\"",
    "dev:mock": "concurrently -k \"npm run dev -w @akagi-ng/frontend\" \"npm run dev:mock -w @akagi-ng/main\"",
    "clean": "tsx scripts/clean.ts",
    "sync-version": "tsx scripts/sync_version.ts",
    "prepare-release": "tsx scripts/prepare_release.ts",
    "build": "npm run clean && npm run sync-version && npm run build -w @akagi-ng/rust-engine && npm run build -w @akagi-ng/frontend && npm run build -w @akagi-ng/main && npm run prepare-release && npm run package -w @akagi-ng/main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --project main --project frontend",
    "test:coverage": "vitest run --coverage --project main --project frontend",
    "test:watch": "vitest --project main --project frontend",
    "test:integration": "vitest run --project integration",
    "test:rust": "cargo test --locked --features dyn-symbols --manifest-path packages/rust_engine/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/frontend/tsconfig.json --noEmit && tsc -p packages/frontend/tsconfig.node.json --noEmit && tsc -p packages/main/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
